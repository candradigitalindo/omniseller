# Copy to .env.local (git-ignored). Every process role reads this file in development; each role only
# validates the keys it uses (src/config/env.schema.ts). Staging and production get values from
# AWS Secrets Manager, never from a file (backend doc 5.1).

# ---- common ----
NODE_ENV=local
LOG_LEVEL=debug
REDIS_QUEUE_URL=redis://127.0.0.1:6379
REDIS_CACHE_URL=redis://127.0.0.1:6380

# ---- database roles (backend doc 7.5) ----
# api, webhook: RLS enforced, cannot read marketplace tokens
DATABASE_URL=postgres://omniseller_api:omniseller_api@127.0.0.1:5433/omniseller
# worker, scheduler (per-tenant jobs), research-collector: RLS enforced, reads tokens
DATABASE_URL_WORKER=postgres://omniseller_worker:omniseller_worker@127.0.0.1:5433/omniseller
# scheduler cross-tenant jobs only: BYPASSRLS
DATABASE_URL_SYSTEM=postgres://omniseller_system:omniseller_system@127.0.0.1:5433/omniseller

# ---- tooling (not read by the app) ----
# pnpm db:migrate
DATABASE_MIGRATOR_URL=postgres://omniseller_migrator:omniseller_migrator@127.0.0.1:5433/omniseller
# pnpm db:bootstrap (local superuser; creates the roles above and the database)
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# ---- api / webhook ----
# PORT defaults to 3000 for api and 3001 for webhook
# Web app origin: CORS allow-list for the API and base URL of links in emails (api, worker)
PUBLIC_WEB_URL=http://localhost:3100

# ---- worker: email ----
# smtp: Mailpit locally (pnpm infra:up, inbox at http://localhost:8025), Amazon SES SMTP in staging/production
# log: prints emails including their links; only allowed with NODE_ENV=local (use it with infra:native)
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=OmniSeller <noreply@omniseller.local>
