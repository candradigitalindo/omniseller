# Copy to .env.local (git-ignored). Every process role reads this file in development; each role only
# validates the keys it uses (src/config/env.schema.ts). Staging and production get values from
# AWS Secrets Manager, never from a file (backend doc 5.1).

# ---- common ----
NODE_ENV=local
LOG_LEVEL=debug
REDIS_QUEUE_URL=redis://127.0.0.1:6379
REDIS_CACHE_URL=redis://127.0.0.1:6380

# ---- database roles (backend doc 7.5) ----
# api, webhook: RLS enforced, cannot read marketplace tokens
DATABASE_URL=postgres://omniseller_api:omniseller_api@127.0.0.1:5433/omniseller
# worker, scheduler (per-tenant jobs), research-collector: RLS enforced, reads tokens
DATABASE_URL_WORKER=postgres://omniseller_worker:omniseller_worker@127.0.0.1:5433/omniseller
# scheduler cross-tenant jobs only: BYPASSRLS
DATABASE_URL_SYSTEM=postgres://omniseller_system:omniseller_system@127.0.0.1:5433/omniseller

# One-shot operations: production mutations require OPS_CONFIRM=1 (src/ops/README.md).
# Leave unset or 0 for ordinary process startup; --dry-run does not need confirmation.
OPS_CONFIRM=0

# ---- tooling (not read by the app) ----
# pnpm db:migrate
DATABASE_MIGRATOR_URL=postgres://omniseller_migrator:omniseller_migrator@127.0.0.1:5433/omniseller
# pnpm db:bootstrap (local superuser; creates the roles above and the database)
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# ---- api / webhook ----
# PORT defaults to 3000 for api and 3001 for webhook
# Web app origin: CORS allow-list for the API and base URL of links in emails (api, worker)
PUBLIC_WEB_URL=http://localhost:3100

# ---- api: verification in two steps (technology doc 5.3, backend doc 8.30) ----
# Seals each user's TOTP secret and keys the backup codes. Given to the api only. The key below is for
# development only (new one: openssl rand -base64 32). Keep it with the database: with another key, the
# codes of everyone who turned 2FA on stop working.
TOTP_ENCRYPTION_KEY=tglAlxH2FEigafuQPeVKlRroi4zTzgTzWHc9kdgLQB8=
# The name authenticator apps show next to the account
TOTP_ISSUER=OmniSeller

# ---- api, worker: private files (technology doc 13): shipping labels, printable documents ----
# local: files in FILE_STORAGE_LOCAL_DIR (relative to backend/), downloaded through the api; refused
#        unless NODE_ENV is local or test. Works without Docker.
# r2:    Cloudflare R2 in staging and production (R2_ACCOUNT_ID). Locally MinIO from `pnpm infra:up`:
#        R2_ENDPOINT=http://127.0.0.1:9000 R2_ACCESS_KEY_ID=omniseller R2_SECRET_ACCESS_KEY=omniseller-minio
FILE_STORAGE=local
FILE_STORAGE_LOCAL_DIR=.local/files
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_DOCUMENTS=omniseller-documents

# ---- worker: email ----
# smtp: Mailpit locally (pnpm infra:up, inbox at http://localhost:8025), Amazon SES SMTP in staging/production
# log: prints emails including their links; only allowed with NODE_ENV=local (use it with infra:native)
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=OmniSeller <noreply@omniseller.local>

# ---- webhook ----
# Public origin of the webhook process (webhook, worker). Shopee signs ${PUBLIC_WEBHOOK_URL}/webhooks/shopee;
# TikTok Shop shops are subscribed to ${PUBLIC_WEBHOOK_URL}/webhooks/tiktokshop. Locally, expose port 3001
# with a tunnel to receive real pushes.
PUBLIC_WEBHOOK_URL=http://localhost:3001

# ---- marketplaces (technology doc 26.2) ----
# A marketplace whose keys are empty is "not configured": listed as unavailable, connecting is refused.
# Shopee Open Platform (open.shopee.com console). api needs the partner id; webhook and worker also the key.
# Register the redirect domain of PUBLIC_WEB_URL in the console (redirect: /integrasi/callback/shopee).
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Sandbox: https://openplatform.sandbox.test-stable.shopee.sg and https://open.sandbox.test-stable.shopee.com
SHOPEE_API_BASE_URL=https://partner.shopeemobile.com
SHOPEE_AUTH_BASE_URL=https://open.shopee.com
# TikTok Shop Partner Center ("Tokopedia & Shop" in Indonesia). api needs service id and the public app key
# for creator links; only webhook and worker receive the app secret. Redirect URL for seller/creator/partner:
# ${PUBLIC_WEB_URL}/integrasi/callback/tiktokshop. Creator API/TAP scopes/test access require platform approval.
TIKTOKSHOP_SERVICE_ID=
TIKTOKSHOP_APP_KEY=
TIKTOKSHOP_APP_SECRET=
TIKTOKSHOP_AUTHORIZE_URL=https://services.tiktokshop.com/open/authorize
TIKTOKSHOP_CREATOR_AUTHORIZE_URL=https://shop.tiktok.com/alliance/creator/auth
TIKTOKSHOP_PARTNER_AUTHORIZE_URL=https://partner.tiktokshop.com/open/authorize
TIKTOKSHOP_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOKSHOP_AUTH_BASE_URL=https://auth.tiktok-shops.com

# ---- worker: copying listings between stores (FR-PRD-13, backend doc 8.25) ----
# Shopee asks for at least 5 seconds between add_item and init_tier_variation.
SHOPEE_VARIANT_DELAY_MS=5000
# Product images are downloaded only from Shopee and TikTok Shop image hosts; extra hosts, comma separated
# (plain http only when NODE_ENV is local or test).
PRODUCT_IMAGE_HOSTS=

# ---- worker: marketplace token encryption (technology doc 19.3) ----
# local: tenant keys wrapped with TOKEN_LOCAL_MASTER_KEY; refused unless NODE_ENV is local or test.
#        The key below is for development only (new one: openssl rand -base64 32).
# aws_kms: staging and production, with KMS_KEY_ID_TOKENS (key id or ARN) and AWS_REGION.
TOKEN_KEY_PROVIDER=local
TOKEN_LOCAL_MASTER_KEY=V09gv6YZwT7OXPqauNsvRMMKrbfDFPqh2oo8KQ+XUME=
KMS_KEY_ID_TOKENS=
AWS_REGION=ap-southeast-3

# ---- subscriptions and billing (technology doc ADR-020, backend doc 8.32) ----
# api: whether a paid plan can be chosen. off: plans are shown, paid ones cannot be chosen yet.
BILLING_PAYMENTS=off
# api and worker: the issuer printed on invoice PDFs (downloaded, and attached to the "payment received"
# email): legal name, address (one line), NPWP (15 or 16 digits), and an email for billing questions. Only
# the name is required; empty parts are left off the document.
BILLING_ISSUER_NAME=OmniSeller
BILLING_ISSUER_ADDRESS=
BILLING_ISSUER_NPWP=
BILLING_ISSUER_EMAIL=
# worker: Xendit secret API key (Dashboard > Settings > Developers > API keys); test-mode keys start with
# xnd_development_. Empty: invoices are written but marked failed ("payments not configured").
XENDIT_SECRET_KEY=
XENDIT_API_BASE_URL=https://api.xendit.co
# webhook: Xendit's Callback Verification Token (Dashboard > Settings > Developers > Callbacks). The invoice
# callback URL to register there is ${PUBLIC_WEBHOOK_URL}/webhooks/xendit.
XENDIT_WEBHOOK_TOKEN=
