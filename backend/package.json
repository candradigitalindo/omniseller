{
  "name": "@omniseller/backend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "build:packages": "pnpm -r --filter \"./packages/**\" run build",
    "build": "pnpm build:packages && tsc -p tsconfig.build.json",
    "typecheck": "pnpm build:packages && pnpm -r --filter \"./packages/**\" run typecheck && tsc -p tsconfig.json --noEmit",
    "predev": "pnpm build:packages",
    "dev": "node tools/dev.mjs api webhook worker scheduler",
    "dev:api": "pnpm build:packages && node tools/dev.mjs api",
    "dev:webhook": "pnpm build:packages && node tools/dev.mjs webhook",
    "dev:worker": "pnpm build:packages && node tools/dev.mjs worker",
    "dev:scheduler": "pnpm build:packages && node tools/dev.mjs scheduler",
    "start": "node --enable-source-maps dist/main.js",
    "infra:up": "docker compose -f infra/docker/compose.local.yml up -d",
    "infra:down": "docker compose -f infra/docker/compose.local.yml down",
    "infra:reset": "docker compose -f infra/docker/compose.local.yml down -v",
    "infra:native": "bash tools/scripts/native-infra.sh",
    "db:bootstrap": "tsx --env-file-if-exists=.env.local src/db/bootstrap.cli.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.cli.ts",
    "test": "pnpm -r --filter \"./packages/**\" run test && vitest run --project unit",
    "test:int": "pnpm build:packages && vitest run --project integration",
    "test:schema": "pnpm build:packages && vitest run --project integration test/schema",
    "test:all": "pnpm test && pnpm test:int",
    "lint": "biome check .",
    "format": "biome format --write .",
    "openapi:emit": "pnpm build && node dist/openapi/emit.cli.js",
    "test:isolation": "pnpm build:packages && vitest run --project integration test/tenant-isolation"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1144.0",
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@node-rs/argon2": "2.2.1",
    "@omniseller/connector-core": "workspace:*",
    "@omniseller/connector-shopee": "workspace:*",
    "@omniseller/connector-tiktokshop": "workspace:*",
    "@omniseller/logging": "workspace:*",
    "@omniseller/shared": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.3",
    "ioredis": "5.11.1",
    "nestjs-zod": "5.5.0",
    "nodemailer": "10.0.13",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yazl": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.13",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/yazl": "3.3.1",
    "fflate": "0.8.3",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
