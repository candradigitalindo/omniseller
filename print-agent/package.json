{
  "name": "@omniseller/print-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agen cetak lokal OmniSeller",
  "author": "OmniSeller",
  "license": "UNLICENSED",
  "main": "dist/main.cjs",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "pnpm build && node scripts/test-build.mjs && playwright test",
    "api:types": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "pack": "pnpm build && pnpm vendor && electron-builder --dir",
    "dist:win": "pnpm build && pnpm vendor --source && electron-builder --win nsis --x64",
    "dist:mac": "pnpm build && electron-builder --mac dmg --arm64",
    "release": "pnpm build && pnpm vendor --source && node scripts/release.mjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "pdf-to-printer": "5.8.1",
    "socket.io-client": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "openapi-typescript": "7.13.0",
    "socket.io": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
