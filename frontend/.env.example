# Alamat proses api. Next meneruskan /v1/* ke sini saat build/dev.
# Harus tersedia juga saat runtime: proxy web menangkap kode pemasangan App Store secara server-side
# melalui API ini sebelum login. Tidak menyimpan rahasia marketplace di web app.
API_ORIGIN=http://localhost:3000

# Alamat situs publik (website/). Bila diisi, persetujuan di halaman Daftar menautkan Syarat Layanan dan
# Kebijakan Privasi di sana; kosong: dokumennya hanya disebut. Dibaca saat `next build`.
NEXT_PUBLIC_SITE_URL=
