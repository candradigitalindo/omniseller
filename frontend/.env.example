# Alamat proses api. Next meneruskan /v1/* ke sini; dibaca saat `next build` dan `next dev`.
# Di produksi ALB meneruskan /v1/* ke api, jadi variabel ini tidak dipakai.
API_ORIGIN=http://localhost:3000

# Alamat situs publik (website/). Bila diisi, persetujuan di halaman Daftar menautkan Syarat Layanan dan
# Kebijakan Privasi di sana; kosong: dokumennya hanya disebut. Dibaca saat `next build`.
NEXT_PUBLIC_SITE_URL=
